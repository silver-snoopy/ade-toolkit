          <mxGeometry x="20" y="54" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="&lt;font style=&quot;font-size:11px;color:#7da36e&quot;&gt;PHASE 5&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:16px&quot;&gt;Quality Gate&lt;/b&gt;&lt;br&gt;&lt;br&gt;Automated checks&lt;br&gt;in strict order&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;lint &#183; types &#183; tests &#183; coverage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="gBuild">
