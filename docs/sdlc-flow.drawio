        </mxCell>

        <mxCell id="gShip" value="VERIFY &amp; SHIP" style="swimlane;startSize=38;html=1;fontSize=15;fontStyle=1;fontColor=#a06a00;fillColor=#fff5ea;strokeColor=#e0bd8a;rounded=1;arcSize=3;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1536" y="175" width="692" height="230" as="geometry" />
