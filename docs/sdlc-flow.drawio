        </mxCell>
        <mxCell id="v8" value="&lt;font style=&quot;font-size:11px;color:#c0913f&quot;&gt;PHASE 8&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:16px&quot;&gt;Commit &amp;amp; PR&lt;/b&gt;&lt;br&gt;&lt;br&gt;Clean commits + PR&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;acceptance-coverage summary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="gShip">
          <mxGeometry x="472" y="54" width="200" height="150" as="geometry" />
        </mxCell>

