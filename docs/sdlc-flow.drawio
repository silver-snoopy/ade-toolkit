        <mxCell id="title" value="SDLC flow" style="text;html=1;align=center;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="20" y="18" width="2520" height="46" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="A 10-phase agentic SDLC &#8212; orchestrator + bounded workers. Each phase gates the next; the retrospective compounds learnings back into research." style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#555555;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="72" width="2520" height="26" as="geometry" />
        </mxCell>

        <mxCell id="gDiscover" value="DISCOVER" style="swimlane;startSize=38;html=1;fontSize=15;fontStyle=1;fontColor=#3b5b80;fillColor=#eef4fb;strokeColor=#9bb7d4;rounded=1;arcSize=3;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="175" width="466" height="230" as="geometry" />
        </mxCell>
        <mxCell id="d0" value="&lt;font style=&quot;font-size:11px;color:#7a93b3&quot;&gt;PHASE 0&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:16px&quot;&gt;Intent&lt;/b&gt;&lt;br&gt;&lt;br&gt;Extract structured&lt;br&gt;requirements&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;source of truth for &#8216;done&#8217;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="gDiscover">
          <mxGeometry x="20" y="54" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;font style=&quot;font-size:11px;color:#7a93b3&quot;&gt;PHASE 1&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:16px&quot;&gt;Research&lt;/b&gt;&lt;br&gt;&lt;br&gt;Verified durable spec&lt;br&gt;(R1&#8211;R5)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;spec + glossary + ADRs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="gDiscover">
          <mxGeometry x="246" y="54" width="200" height="150" as="geometry" />
        </mxCell>

        <mxCell id="gDesign" value="DESIGN" style="swimlane;startSize=38;html=1;fontSize=15;fontStyle=1;fontColor=#6a4a86;fillColor=#f5eef8;strokeColor=#b39ac6;rounded=1;arcSize=3;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="532" y="175" width="466" height="230" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;font style=&quot;font-size:11px;color:#9b7eb3&quot;&gt;PHASE 2&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:16px&quot;&gt;Plan&lt;/b&gt;&lt;br&gt;&lt;br&gt;Actionable&lt;br&gt;implementation plan&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;the contract for the build&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="gDesign">
          <mxGeometry x="20" y="54" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;font style=&quot;font-size:11px;color:#9b7eb3&quot;&gt;PHASE 3&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:16px&quot;&gt;Design Check&lt;/b&gt;&lt;br&gt;&lt;br&gt;Stubs &amp;amp; interfaces&lt;br&gt;in a worktree&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;validate architecture early&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="gDesign">
          <mxGeometry x="246" y="54" width="200" height="150" as="geometry" />
        </mxCell>

        <mxCell id="gBuild" value="BUILD" style="swimlane;startSize=38;html=1;fontSize=15;fontStyle=1;fontColor=#4a7a3a;fillColor=#eef7ec;strokeColor=#a6c79a;rounded=1;arcSize=3;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1034" y="175" width="466" height="230" as="geometry" />
